# gChess Local Development Environment Configuration
# Copy this file to .env and update values as needed
# DO NOT commit .env to version control!

# Environment
ENVIRONMENT=local

# Server Configuration
PORT=8080

# Database Configuration (matches docker/docker-compose.yml)
DATABASE_URL=jdbc:postgresql://postgres:5432/gchess_dev
DATABASE_USER=gchess
DATABASE_PASSWORD=gchess
DATABASE_POOL_SIZE=10

# JWT Configuration
# WARNING: This is a development-only secret!
# Generate a secure secret for production using: openssl rand -base64 32
JWT_SECRET=dev-secret-DO-NOT-USE-IN-PRODUCTION
JWT_VALIDITY_MS=86400000

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173

# Logging
LOG_LEVEL=DEBUG