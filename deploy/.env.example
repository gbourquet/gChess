# ============================================================
# Configuration du serveur de production gChess
# ============================================================
# À copier en /opt/gchess/.env sur le serveur, puis à compléter.
# Ce fichier n'est JAMAIS écrasé par la CI : les workflows ne
# réécrivent que les lignes BACK_IMAGE et FRONT_IMAGE.
#
#   cp .env.example .env && chmod 600 .env
# ============================================================

# Domaine servi (utilisé pour CORS_ORIGINS ; le TLS est géré par le
# nginx système, voir deploy/nginx-host/gchess.conf)
DOMAIN=chess.example.com

# Port HTTP publié sur 127.0.0.1, vers lequel le nginx système proxifie.
# À changer si 8080 est déjà pris sur l'hôte : ss -tlnp | grep 8080
HTTP_PORT=8080

# --- Images (mises à jour automatiquement par GitHub Actions) ---
# Remplacer <votre-compte> par votre compte ou organisation GitHub.
BACK_IMAGE=ghcr.io/<votre-compte>/gchess-back:latest
FRONT_IMAGE=ghcr.io/<votre-compte>/gchess-front:latest

# --- PostgreSQL ---
DATABASE_NAME=gchess
DATABASE_USER=gchess
# openssl rand -base64 24
#
# ⚠️ Ce mot de passe n'est appliqué qu'à la PREMIÈRE initialisation, quand le
# volume pgdata est vide. Le modifier plus tard ici ne change rien à la base :
# il faut aussi jouer un ALTER USER, voir « Changer le mot de passe de la
# base » dans README.md. Ne pas écraser ce fichier sans sauvegarder sa valeur.
DATABASE_PASSWORD=CHANGE_ME
DATABASE_POOL_SIZE=10

# --- JWT ---
# OBLIGATOIRE : openssl rand -base64 32
# Changer ce secret invalide tous les tokens déjà émis.
JWT_SECRET=CHANGE_ME
JWT_VALIDITY_MS=86400000

# --- Logs ---
LOG_LEVEL=INFO
