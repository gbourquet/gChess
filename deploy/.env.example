# ============================================================
# Configuration du serveur de production gChess
# ============================================================
# À copier en /opt/gchess/.env sur le serveur, puis à compléter.
# Ce fichier n'est JAMAIS écrasé par la CI : les workflows ne
# réécrivent que les lignes BACK_IMAGE et FRONT_IMAGE.
#
#   cp .env.example .env && chmod 600 .env
# ============================================================

# Domaine servi par nginx (certificat Let's Encrypt)
DOMAIN=gchess.sur-le-web.fr

# Adresse e-mail pour les alertes d'expiration Let's Encrypt
LETSENCRYPT_EMAIL=gbourquet@gmail.com

# --- Images (mises à jour automatiquement par GitHub Actions) ---
BACK_IMAGE=ghcr.io/gbourquet/gchess-back:latest
FRONT_IMAGE=ghcr.io/gbourquet/gchess-front:latest

# --- PostgreSQL ---
DATABASE_NAME=gchess
DATABASE_USER=gchess
# openssl rand -base64 24
DATABASE_PASSWORD=CHANGE_ME
DATABASE_POOL_SIZE=10

# --- JWT ---
# OBLIGATOIRE : openssl rand -base64 32
# Changer ce secret invalide tous les tokens déjà émis.
JWT_SECRET=CHANGE_ME
JWT_VALIDITY_MS=86400000

# --- Logs ---
LOG_LEVEL=INFO
